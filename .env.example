# Copy to .env ONLY for local backend tooling. The mobile app never reads this file.
# The API token is entered by the user inside the app (Settings -> API Token)
# and stored in the device Keychain / Keystore via flutter_secure_storage.
PANDA_API_BASE_URL=https://panda-voice-ai-production.up.railway.app
# PANDA_API_KEY=do_not_commit_a_real_key_here
